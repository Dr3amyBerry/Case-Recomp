{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://case-recomp.invalid/schema/scenario-v1.json",
  "title": "Case-Recomp Scenario v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "id", "design", "scenes", "events"],
  "properties": {
    "format": {"const": "case-recomp-scenario"},
    "version": {"const": 1},
    "id": {"type": "string", "minLength": 1, "maxLength": 128},
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": {"type": "integer", "minimum": 1, "maximum": 16384},
        "height": {"type": "integer", "minimum": 1, "maximum": 16384}
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2048,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "frame_start", "frame_end", "targets"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 128},
          "frame_start": {"type": "integer", "minimum": 1, "maximum": 10000000},
          "frame_end": {"type": "integer", "minimum": 1, "maximum": 10000000},
          "targets": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4096,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "rect", "z"],
              "properties": {
                "id": {"type": "string", "minLength": 1, "maxLength": 128},
                "rect": {"type": "array", "minItems": 4, "maxItems": 4,
                         "items": {"type": "integer", "minimum": -16384, "maximum": 16384}},
                "z": {"type": "integer", "minimum": -32768, "maximum": 32767}
              }
            }
          }
        }
      }
    },
    "events": {
      "type": "array",
      "maxItems": 16384,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 128},
          "kind": {"enum": ["enter", "leave", "target-found", "frame-reached", "scenario-complete"]},
          "scene": {"type": "string", "minLength": 1, "maxLength": 128},
          "target": {"type": "string", "minLength": 1, "maxLength": 128},
          "frame": {"type": "integer", "minimum": 1, "maximum": 10000000},
          "to_scene": {"type": "string", "minLength": 1, "maxLength": 128}
        }
      }
    }
  }
}
